# cw's launcher-only settings for `job/static-names.sh` (everything else is in `job/static-names.json`)
export DISKY_LABELS=${DISKY_LABELS:-app=disky,deployment=cw}
# cw's own Batch task logs (infra/gcp `cw-task-logs`, specs/per-deployment-task-logs.md): jobs read their helpers' through it
export DT_TASK_LOG_VIEW=${DT_TASK_LOG_VIEW:-projects/oa-internal-450019/locations/global/buckets/cw-task-logs/views/cw}
