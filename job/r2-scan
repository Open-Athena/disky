HERE = Path(__file__).resolve().parent


def profile() -> dict:
    return loads((HERE / "r2.json").read_text())


def job_run() -> "JobRun":
    """This run's view through the shared job wrapper (`dt_cloud.scan_runs.JobRun`, what the shell jobs drive as
    `dt-cloud scan-run start / phase / finish`): the profile, the run id (`BATCH_JOB_UID`), the D1 record and the
    state file the phases, `finish` and an enclosing `scan-run supervise` share."""
    from dt_cloud.scan_runs import JobRun

    return JobRun(str(HERE / "r2-scan-runs.json"), profile()["database_id"], False, environ.get("BATCH_JOB_UID", "").strip() or None, None)


def exit_code(exc: BaseException | None) -> int:
    """A failure's exit status: a subprocess's own (a signal death as 128+N), else 1."""
    if exc is None:
        return 0
    code = getattr(exc, "returncode", None)
    if not isinstance(code, int) or code == 0:
        return 1
    return 128 - code if code < 0 else min(code, 255)


class ScanReporter:
    """The run's record and alerts through the shared job wrapper (`job_run`): the scan-run row and its phases in D1
    (/scans), one `fail` alert per failed run naming its phase, a `warn` per failed non-fatal step, and the pointer
    the image's entrypoint (`dt-cloud scan-run supervise`) finishes the run from when the job is killed before its own
    exit (a preemption, the OOM killer). Best-effort: a reporting outage never interrupts publication."""

    def __init__(
        self,
        scan: str,
        generation: str,
    ) -> None:
        self.scan = scan
        self.generation = generation
        self.job = None
        environ.setdefault("DT_JOB_START", str(int(time())))  # the PHASE lines' clock
        self.run = job_run()

    def __enter__(self) -> "ScanReporter":
        # The Batch-assigned task-group resource is exposed on the VM's instance metadata.
        # Reading the local metadata needs no Batch API or additional IAM.
        from urllib.request import Request, urlopen

        try:
            name = environ.get("OA_R2_JOB_NAME")
            if not name:
                request = Request("http://metadata.google.internal/computeMetadata/v1/instance/attributes/cloudbatch-task-group", headers={"Metadata-Flavor": "Google"})
                with urlopen(request, timeout=5) as response:
                    group_name = response.read().decode().strip()
                match = fullmatch(r"projects/[^/]+/locations/" + escape(profile()["region"]) + r"/jobs/([a-z][a-z0-9-]{0,62})/taskGroups/[^/]+", group_name)
                if not match:
                    raise ValueError("Invalid Batch task-group resource in instance metadata")
                name = match[1]
            if not fullmatch(r"[a-z][a-z0-9-]{0,62}", name):
                raise ValueError("Invalid Batch job ID in instance metadata")
            self.job = {**job_spec(environ["OA_R2_IMAGE"], profile()), "name": f"projects/{profile()['project']}/locations/{profile()['region']}/jobs/{name}"}
        except (Exception, SystemExit) as exc:
            print(f"Batch link metadata unavailable: {type(exc).__name__}", file=stderr, flush=True)
        print(f"OA-R2-SCAN-START {self.scan} {self.generation}", file=stderr, flush=True)
        # `scan-run start`'s steps, in process
        self.run.clear()
        self.run.save(fresh=True, scan=self.scan, kind="scan", gen=self.generation)
        rec = self.run.write(start=True, job=self.job)
        if rec is not None:
            self.run.save(region=rec.run.region, job_name=rec.run.job_name)
        self.run.point_supervisor(str(HERE / "r2-scan-runs.json"), profile()["database_id"], False, None)
        return self

    @contextmanager
    def phase(self, name: str):
        """A fatal phase: a failure inside records it failed, alerts `fail` once (naming it) and propagates."""
        self.run.begin(name)
        try:
            yield
        except BaseException as exc:
            self.run.end(name, exit_code(exc), msg=type(exc).__name__)
            raise
        self.run.end(name)

    def step(self, name: str, command: list[str], env: dict[str, str], meaning: str) -> int:
        """A non-fatal phase running COMMAND: a failure records it failed and alerts `warn` (with what it means); the
        scan stands. Returns COMMAND's exit status."""
        self.run.begin(name)
        rc = run(command, env=env).returncode
        self.run.end(name, rc, warn=True, msg=meaning, measure=False)
        return rc

    def __exit__(
        self,
        exc_type: type | None,
        exc: BaseException | None,
        traceback: object,
    ) -> None:
        # Error types and exit codes are safe to report without serializing credentials or request bodies.
        rc = exit_code(exc)
        self.run.finish(rc, exc_type.__name__ if exc_type else None)
        if self.run.supervised:
            self.run.save(finished=rc)  # `supervise` reads it (and clears the state) once the job has exited
        else:
            self.run.clear()


def build_command(context: Path, tag: str, config: dict) -> list[str]:
    if not fullmatch(r"[a-z0-9][a-z0-9._-]{0,127}", tag):
        raise ValueError("Choose a lowercase image tag of at most 128 characters")
    image = f"{config['region']}-docker.pkg.dev/{config['project']}/{config['image_repository']}/scan:{tag}"
    return [
        "gcloud", "builds", "submit", str(context),
        "--project", config["project"], "--region", config["region"],
        "--config", str(context / "job/cloudbuild.yaml"),
        "--service-account", f"projects/{config['project']}/serviceAccounts/{config['builder_account']}@{config['project']}.iam.gserviceaccount.com",
        "--gcs-source-staging-dir", f"gs://{config['scratch_bucket']}/builds/source",
        "--polling-interval", "15",
        "--substitutions", f"_IMAGE={image}",
    ]


def alert(level: str, message: str) -> None:
    """A `fail` / `warn` alert through the shared job wrapper's channel (`scan_runs.JobRun.alert`: `disk-tree notify`,
    redacted of the profile's `secrets`, the Batch logs link): Slack once `SLACK_BOT_TOKEN` and `SLACK_ALERT_CHANNEL`
    are set, else printed. Never raises."""
    try:
        job_run().alert(level, message)
    except Exception as exc:  # noqa: BLE001 — alerting must never mask what it reports
        print(f"alert failed (the job continues): {type(exc).__name__}", file=stderr, flush=True)


def index_env() -> dict[str, str]:
    """The job's env with the serving bucket's key as the ambient S3 credentials: what a `dt-cloud` stage that reads
    `r2://<serving>` from its own process (`index-sync`'s uploaded-generation check, the index stores' existence checks)
    authenticates with. The primary scan's listing env carries the source key instead."""
    return {**environ, "AWS_ACCESS_KEY_ID": environ["R2_ACCESS_KEY_ID"].strip(), "AWS_SECRET_ACCESS_KEY": environ["R2_SECRET_ACCESS_KEY"].strip()}


def verify_uploads(publisher: object, bucket: str, files: list[tuple[str, int]]) -> None:
    for key, size in files:
        actual = publisher.head_object(Bucket=bucket, Key=key)["ContentLength"]
        if actual != size:
            raise ValueError(f"Published object size mismatch: {key}: {actual} != {size}")


def build_age(path: Path, out: Path) -> None:
    from duckdb import connect
    from dt_cloud.index import write_age_pyramid

    with connect() as con:
        con.execute("SET memory_limit='12GB'; SET threads=8")
        write_age_pyramid(con, str(path), out)
        verify_age(con, path, out)


def verify_age(
    con: object,
    path: Path,
    out: Path,
) -> None:
    from dt_cloud.index import AGE_PYRAMID_BINS
    from pyarrow.parquet import read_metadata

    population = con.execute(
        "SELECT split_part(path, '/', 1), sum(size)::BIGINT, count(*) FROM read_parquet(?) WHERE kind = 'file' AND mtime > 0 GROUP BY 1 ORDER BY 1",
        [str(path)],
    ).fetchall()
    root = (sum(row[1] for row in population), sum(row[2] for row in population))
    for bin in AGE_PYRAMID_BINS:
        tier = out / f"age-pyramid-{bin}.parquet"
        floor = int(read_metadata(tier).metadata[b"coarse_floor"])
        expected = [(bucket, size, count) for bucket, size, count in population if size >= floor]
        actual = con.execute(
            "SELECT path, sum(b)::BIGINT, sum(o)::BIGINT FROM read_parquet(?) WHERE depth = 1 GROUP BY path ORDER BY path",
            [str(tier)],
        ).fetchall()
        fleet = con.execute("SELECT coalesce(sum(b), 0)::BIGINT, coalesce(sum(o), 0)::BIGINT FROM read_parquet(?) WHERE depth = 0", [str(tier)]).fetchone()
        if actual != expected or fleet != root:
            raise ValueError(f"Age pyramid {bin} does not match the dated path population")


def job_spec(image: str, config: dict) -> dict:
    repository = f"{config['region']}-docker.pkg.dev/{config['project']}/{config['image_repository']}/scan"
    if not fullmatch(escape(repository) + r"@sha256:[a-f0-9]{64}", image):
        raise ValueError("Image must be pinned by digest in this deployment's scan repository")
    variables = {
        "AWS_DEFAULT_REGION": "auto",
        "AWS_EC2_METADATA_DISABLED": "true",
        "CLOUDFLARE_ACCOUNT_ID": config["account"],
        "D1_DB_ID": config["database_id"],
        "D1_DB_NAME": config["database_name"],
        "DISK_TREE_R2_ENDPOINT_URL": f"https://{config['account']}.r2.cloudflarestorage.com",
        "DUCKDB_MEM": "12GB",
        "DUCKDB_THREADS": "8",
        "OA_R2_IMAGE": image,
        "DISKY_LABELS": "app=disky,deployment=oa-r2,component=scan",
        "SITE_URL": config["site_url"],
        **{name: config[key] for name, key in (("SLACK_CHANNEL", "slack_channel"), ("SLACK_ALERT_CHANNEL", "slack_alert_channel")) if config[key]},
    }
    # Batch refuses a job whose secret has no version, so an optional secret is passed only once it is listed live
    # (its version added): until then the step it serves is skipped (`serve`, `alert`).
    if unknown := sorted(set(config["optional_secrets_live"]) - set(config["optional_secrets"])):
        raise ValueError(f"optional_secrets_live names no optional secret: {unknown}")
    secrets = {**config["secrets"], **{name: config["optional_secrets"][name] for name in config["optional_secrets_live"]}}
    return {
        "taskGroups": [{
            "taskCount": 1,
            "parallelism": 1,
            "taskSpec": {
                "runnables": [{"container": {
                    "imageUri": image,
                    "volumes": ["/mnt/disks/r2-stage:/stage"],
                }}],
                "computeResource": {"cpuMilli": 8000, "memoryMib": config["memory_mib"]},
                "maxRetryCount": 0,
                "maxRunDuration": f"{config['timeout_seconds']}s",
                "environment": {
                    "variables": variables,
                    "secretVariables": {
                        name: f"projects/{config['project']}/secrets/{secret}/versions/latest"
                        for name, secret in secrets.items()
                    },
                },
                "volumes": [{"mountPath": "/mnt/disks/r2-stage", "deviceName": "r2-stage"}],
            },
        }],
        "allocationPolicy": {
            "instances": [{"policy": {
                "machineType": config["machine"],
                "provisioningModel": "STANDARD",
                "disks": [{"deviceName": "r2-stage", "newDisk": {"type": "pd-balanced", "sizeGb": config["disk_gb"]}}],
            }}],
            "serviceAccount": {"email": f"{config['job_account']}@{config['project']}.iam.gserviceaccount.com"},
            "labels": {"app": "disky", "deployment": "oa-r2", "component": "scan"},
        },
        "labels": {"app": "disky", "deployment": "oa-r2", "component": "scan"},
        "logsPolicy": {"destination": "CLOUD_LOGGING"},
    }


def verify_scan(
    work: Path,
    config: dict,
    scan: str,
) -> dict:
    from duckdb import connect

    con = connect()
    listing = str(work / "listing/*/shard-*.parquet")
    counts = con.execute(
        "SELECT bucket, sum(size_bytes)::BIGINT, count(*) FROM read_parquet(?) GROUP BY bucket ORDER BY bucket",
        [listing],
    ).fetchall()
    expected = {bucket: {"bytes": 0, "objects": 0} for bucket in config["buckets"]}
    for bucket, size, count in counts:
        if bucket not in expected:
            raise ValueError(f"Unexpected listing bucket: {bucket}")
        expected[bucket] = {"bytes": size, "objects": count}
    path = str(work / "index/path-index.parquet")
    totals = con.execute("SELECT path, size, n_files FROM read_parquet(?) WHERE depth = 1 ORDER BY path", [path]).fetchall()
    indexed = {bucket: {"bytes": size, "objects": count} for bucket, size, count in totals}
    if indexed != {bucket: value for bucket, value in expected.items() if value["objects"]}:
        raise ValueError("Per-bucket path totals do not match the complete listing")
    expected_totals = {"bytes": sum(value["bytes"] for value in expected.values()), "objects": sum(value["objects"] for value in expected.values())}
    meta = loads((work / "snap/meta.json").read_text())
    if {"bytes": meta["total_bytes"], "objects": meta["total_objects"]} != expected_totals:
        raise ValueError("Snapshot totals do not match the complete listing")
    age = loads((work / "snap/age.json").read_text())
    known = con.execute(
        "SELECT coalesce(sum(size_bytes), 0)::BIGINT, count(*) FROM read_parquet(?) WHERE created IS NOT NULL",
        [listing],
    ).fetchone()
    if (sum(row["b"] for row in age), sum(row["o"] for row in age)) != known:
        raise ValueError("Last-modified histogram does not match the dated listing population")
    verify_age(con, Path(path), work / "index")
    from dt_cloud.bysize_check import check_views

    checks = check_views(path, str(work / "index/path-index-bysize.parquet"), con=con)
    if not all(check.exact for check in checks):
        raise ValueError("Bysize totals do not match the path sort")
    return {"scan": scan, "date_basis": "last_modified", "buckets": expected, "totals": expected_totals}


@group()
def main() -> None:
    """OA R2 remote metadata scans; plan emits a reviewable Batch spec."""


@main.command()
@option("-n", "--dry-run", is_flag=True, help="Stage the minimal source context and print the build command without uploading")
@argument("tag")
def build(dry_run: bool, tag: str) -> None:
    root = HERE.parent
    context = root / "tmp" / f"oa-r2-build-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')}"
    command = build_command(context, tag, profile())
    context.mkdir(parents=True, exist_ok=False)
    for directory in ("src", "cloud/src", "job/icons-r2", "job/nf", "job/profiles"):
        copytree(root / directory, context / directory, ignore=ignore_patterns("__pycache__", "*.pyc"))
    for filename in ("README.md", "pyproject.toml", "uv.lock", "cloud/pyproject.toml", "job/Dockerfile", "job/cloudbuild.yaml", "job/r2.json", "job/r2-scan-runs.json", "job/r2-nf-scan-runs.json", "job/r2-scan", "job/digest.yml"):
        target = context / filename
        target.parent.mkdir(parents=True, exist_ok=True)
        copy2(root / filename, target)
    print(join(command), file=stderr)
    if not dry_run:
        run(command, check=True)


@main.command()
@option("-H", "--head", "head_profile", help="Plan a Nextflow head's job over this profile (a `job/profiles/` path) instead of the one-VM scan")
@argument("image")
def plan(head_profile: str | None, image: str) -> None:
    planned = job_spec(image, profile())
    if head_profile:
        head_job(planned, head_profile)
    print(dumps(planned, indent=2))


@main.command()
@option("-g", "--generation", help="Archived generation to backfill (requires --scan)")
@option("-H", "--head", "head_profile", help="Run the scan on the generic Nextflow pipeline: `dt-cloud scan head` over this profile (a `job/profiles/` path)")
@option("-i", "--index-only", is_flag=True, help="Build or catch up both stores' static name and interval indexes; no scan")
@option("-m", "--meta-only", is_flag=True, help="Scan only this deployment's derived storage")
@option("-n", "--name", required=True, help="New Batch job name, starting oa-r2-scan-")
@option("-s", "--scan", help="Backfill age indexes for this existing scan (requires --generation)")
@argument("image")
def submit(
    generation: str | None,
    head_profile: str | None,
    index_only: bool,
    meta_only: bool,
    name: str,
    scan: str | None,
    image: str,
) -> None:
    if not fullmatch(r"oa-r2-scan-[a-z0-9-]+", name) or len(name) > 63:
        raise ClickException("Choose an oa-r2-scan- job name of at most 63 characters")
    config = profile()
    scratch = HERE.parent / "tmp"
    scratch.mkdir(exist_ok=True)
    spec = scratch / f"{name}.json"
    planned = job_spec(image, config)
    planned["taskGroups"][0]["taskSpec"]["environment"]["variables"]["OA_R2_JOB_NAME"] = name
    if index_only:
        if meta_only or scan or generation:
            raise ClickException("Index-only is its own job mode")
        task = planned["taskGroups"][0]["taskSpec"]
        task["runnables"][0]["container"].update(entrypoint="python", commands=["job/r2-scan", "index"])
        for secret in ("SOURCE_ACCESS_KEY_ID", "SOURCE_SECRET_ACCESS_KEY"):
            del task["environment"]["secretVariables"][secret]
    if head_profile:
        if index_only or meta_only or scan or generation:
            raise ClickException("A Nextflow head is its own job mode")
        head_job(planned, head_profile)
    if meta_only:
        if scan or generation:
            raise ClickException("Meta-only and age backfill are separate job modes")
        planned["taskGroups"][0]["taskSpec"]["environment"]["variables"]["OA_R2_META_ONLY"] = "1"
    if scan or generation:
        if not scan or not generation:
            raise ClickException("Backfill requires both --scan and --generation")
        validate_archive(scan, generation)
        task = planned["taskGroups"][0]["taskSpec"]
        task["runnables"][0]["container"].update(entrypoint="python", commands=["job/r2-scan", "backfill-age", scan, generation])
        for secret in ("SOURCE_ACCESS_KEY_ID", "SOURCE_SECRET_ACCESS_KEY"):
            del task["environment"]["secretVariables"][secret]
    spec.write_text(dumps(planned, indent=2) + "\n")
    run([
        "gcloud", "batch", "jobs", "submit", name,
        "--project", config["project"], "--location", config["region"], "--config", str(spec),
    ], check=True)


def head_job(planned: dict, profile_path: str) -> None:
    """Rewrite the one-VM job's spec as a Nextflow head's (`dt-cloud scan head`, specs/pipelines-everywhere.md): the
    head only drives the DAG, each step a Batch task of its own that fetches its own secrets, so a small VM, no stage
    disk, and of the secrets only what the head itself uses when the profile records the run (the scan-run record's
    D1 token, the alert's Slack token)."""
    from yaml import safe_load

    path = HERE.parent / profile_path
    if not path.is_file() or path.parent != HERE / "profiles":
        raise ClickException(f"No profile at job/profiles/{path.name}")
    records = "SCAN_RUNS_PROFILE" in (safe_load(path.read_text()).get("env") or {})
    task = planned["taskGroups"][0]["taskSpec"]
    container = task["runnables"][0]["container"]
    container.update(entrypoint="dt-cloud", commands=["scan", "head", f"/app/job/profiles/{path.name}"], volumes=[])
    task["volumes"] = []
    task["computeResource"] = {"cpuMilli": 2000, "memoryMib": 7000}
    task["maxRunDuration"] = "21600s"
    keep = {"CLOUDFLARE_API_TOKEN", "SLACK_BOT_TOKEN"} if records else set()
    task["environment"]["secretVariables"] = {k: v for k, v in task["environment"]["secretVariables"].items() if k in keep}
    policy = planned["allocationPolicy"]["instances"][0]["policy"]
    policy["machineType"] = "e2-standard-2"
    policy.pop("disks")
    policy["bootDisk"] = {"type": "pd-balanced", "sizeGb": "30"}


def validate_archive(scan: str, generation: str) -> None:
    if not fullmatch(r"\d{4}-\d{2}-\d{2}T\d{4}", scan) or not fullmatch(r"\d{8}T\d{12}Z", generation):
        raise ClickException("Choose an exact archived scan and generation")


@main.command(name="backfill-age")
@argument("scan")
@argument("generation")
def backfill_age(scan: str, generation: str) -> None:
    if "BATCH_TASK_INDEX" not in environ:
        raise ClickException("Age backfills run only on the remote Batch job")
    validate_archive(scan, generation)
    from google.cloud.storage import Client
    from boto3 import client

    config = profile()
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    work = Path("/stage") / stamp
    work.mkdir(parents=True, exist_ok=False)
    data = Client(project=config["project"]).bucket(config["data_bucket"])
    source = work / "path-index.parquet"
    data.blob(f"scans/{scan}/{generation}/index/path-index.parquet").download_to_filename(str(source))
    out = work / "index"
    build_age(source, out)
    publisher = client("s3", endpoint_url=environ["DISK_TREE_R2_ENDPOINT_URL"], region_name="auto", aws_access_key_id=environ["R2_ACCESS_KEY_ID"].strip(), aws_secret_access_key=environ["R2_SECRET_ACCESS_KEY"].strip())
    key = f"listing/{scan}/index/{stamp}"
    uploaded = []
    for path in sorted(out.iterdir()):
        data.blob(f"age-backfills/{scan}/{stamp}/{path.name}").upload_from_filename(str(path), if_generation_match=0)
        object_key = f"{key}/{path.name}"
        publisher.upload_file(str(path), config["serving_bucket"], object_key)
        uploaded.append((object_key, path.stat().st_size))
    verify_uploads(publisher, config["serving_bucket"], uploaded)
    sync = ["dt-cloud", "index-sync", scan, "-A", "-b", f"r2://{config['serving_bucket']}", "-d", str(out), "-g", stamp, "-k", key]
    run([*sync, "-r"], env=index_env(), check=True)
    run([*sync, "-p"], env=index_env(), check=True)
    data.blob(f"age-backfills/{scan}/{stamp}/_SUCCESS.json").upload_from_string(dumps({"scan": scan, "source_generation": generation, "age_generation": stamp}), content_type="application/json", if_generation_match=0)


@main.command(name="verify")
@option("-s", "--scan", required=True, help="Scan identifier for the verification manifest")
@argument("work", type=Path)
def verify(scan: str, work: Path) -> None:
    print(dumps(verify_scan(work, profile(), scan), indent=2))


@main.command(name="backfill-runs")
@option("-n", "--dry-run", is_flag=True, help="Print the reconstructed records without writing D1")
@option("-w", "--save-inputs", type=Path, help="Save the own Batch jobs and task logs for replay and review")
def backfill_runs(dry_run: bool, save_inputs: Path | None) -> None:
    """Reconstruct full R2 scans from own Batch jobs, logs and immutable archives."""
    entry = which("dt-cloud")
    if entry is None:
        raise ClickException("Install this workspace's dt-cloud package before backfilling runs")
    interpreter = Path(entry).parent / "python"
    if Path(python_prefix).resolve() != interpreter.parent.parent.resolve():
        # UV's standalone build/plan environment has no workspace packages; use the installed CLI's environment.
        command = [str(interpreter), str(HERE / "r2-scan"), "backfill-runs"]
        if dry_run:
            command.append("-n")
        if save_inputs:
            command.extend(("-w", str(save_inputs)))
        root = HERE.parent
        source = f"{root / 'src'}:{root / 'cloud/src'}"
        run(command, env={**environ, "PYTHONPATH": source + (":" + environ["PYTHONPATH"] if environ.get("PYTHONPATH") else "")}, check=True)
        return
    from dt_cloud.gcp import log_entries
    from dt_cloud.scan_runs import AnyStore, D1Sink, as_json, load_profile, write_all
    from dt_cloud.scan_runs_backfill import classify, fetch_jobs, reconstruct

    reporting = load_profile(HERE / "r2-scan-runs.json")
    jobs = [job for job in fetch_jobs(reporting.project, reporting.regions) if classify(reporting, job)]
    if not jobs:
        print("No OA R2 full scan jobs found", file=stderr)
        return
    query = 'log_id("batch_task_logs") AND (' + " OR ".join(f"labels.job_uid={dumps(job['uid'])}" for job in jobs) + ")"
    logs = log_entries(query, reporting.project, limit=200_000, asc=True)
    if save_inputs:
        save_inputs.mkdir(parents=True, exist_ok=True)
        (save_inputs / "jobs.json").write_text(dumps(jobs, indent=2) + "\n")
        (save_inputs / "logs.json").write_text(dumps(logs, indent=2) + "\n")
    now = int(time())
    records = reconstruct(reporting, jobs, logs, AnyStore(), now)
    if not dry_run:
        write_all(D1Sink(profile()["database_id"]), records, now)
    print(dumps([as_json(rec) for rec in records], indent=2))
    print(f"OA R2 scan-run backfill: {len(records)} runs", file=stderr)


@main.command(name="index")
def index_run() -> None:
    """Build or catch up both stores' indexes without scanning (the base generations' one-shot)."""
    if "BATCH_TASK_INDEX" not in environ:
        raise ClickException("Index builds run only on a remote Batch job")
    config = profile()
    work = Path("/stage") / datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    for meta in (False, True):
        index_store(config, work / ("meta" if meta else "primary"), MetaReporter(), meta)


@main.command(name="run")
def scan_run() -> None:
    if "BATCH_TASK_INDEX" not in environ:
        raise ClickException("The full scan runs only on its remote Batch job")
    config = profile()
    stamp = datetime.now(timezone.utc)
    scan = stamp.strftime("%Y-%m-%dT%H%M")
    generation = stamp.strftime("%Y%m%dT%H%M%S%fZ")
    work = Path("/stage") / generation
    if environ.get("OA_R2_META_ONLY") == "1":
        execute_meta(config, scan, generation, work)
        return
    with ScanReporter(scan, generation) as reporter:
        execute_scan(config, scan, generation, work, reporter)
        with reporter.phase("meta"):
            execute_meta(config, scan, generation, work / "meta")
        for name, command, env, meaning in gc_steps(config):
            reporter.step(name, command, env, meaning)
        serve(config, scan, reporter)


def serve_steps(config: dict, scan: str) -> list[tuple[str, list[str], dict[str, str], str]]:
    """After a published scan: the site's cache warm-up, the uncached serving probe and the Slack digest, each with
    the env it runs in and what its failure means. A step whose credentials aren't in the env (an optional secret not
    yet live, an unset channel) is left out, and says so."""
    root = f"r2://{config['serving_bucket']}"
    env = index_env()
    steps = []
    if environ.get("SITE_TOKEN", "").strip():
        steps += [
            ("warm-cache", ["dt-cloud", "warm-cache", "-d", scan, "-r", f"{root}/snapshots/r2"], env, "the first viewers of this scan compute their views cold"),
            ("probe", ["dt-cloud", "probe", "-c", "-s", "r2", "-u", config["site_url"], "-o", f"{root}/probes/r2/"], env, "a page load 5xx'd or dropped (the data is fine); see the probe record"),
        ]
    else:
        print("no SITE_TOKEN: cache warm-up and the serving probe skipped", file=stderr, flush=True)
    if all(environ.get(name, "").strip() for name in ("SLACK_BOT_TOKEN", "SLACK_CHANNEL", "SITE_TOKEN", "CF_PAGES_TOKEN")):
        # wrangler (the plot's `pages deploy`) gets the Pages token for this step only
        steps.append(("digest", ["dt-cloud", "digest", "-T", "cw", "-C", str(HERE / "digest.yml"), "-i", str(HERE / "icons-r2"), "-r", f"{root}/snapshots/r2"],
                      {**env, "CLOUDFLARE_API_TOKEN": environ["CF_PAGES_TOKEN"].strip()}, "today's #r2-usage digest reply didn't post (the scan is fine)"))
    else:
        print("no SLACK_BOT_TOKEN + SLACK_CHANNEL + SITE_TOKEN + CF_PAGES_TOKEN: the Slack digest skipped", file=stderr, flush=True)
    return steps


def serve(config: dict, scan: str, reporter: "ScanReporter") -> None:
    """`serve_steps`, each its own phase and never fatal: a failure warns, the scan stands."""
    for name, command, env, meaning in serve_steps(config, scan):
        reporter.step(name, command, env, meaning)


def gc_steps(config: dict) -> list[tuple[str, list[str], dict[str, str], str]]:
    """Superseded index generations, per store (the primary's and meta's): their D1 row groups, then their dirs on the
    serving bucket (`listing/<scan>/index/<gen>/`, `meta-l2/…`) that no pointer names, older than 2 days
    (`dt_cloud.gen_gc`). The dirs are listed only (`-n`, what would go, in the log) until `index_gc_files` is on in
    job/r2.json: R2 has no soft delete, so the first deletions wait for a reviewed list."""
    env = {**index_env(), "R2_ENDPOINT": environ["DISK_TREE_R2_ENDPOINT_URL"]}
    files = ["-F", f"r2://{config['serving_bucket']}"]
    steps = []
    for store in ("primary", "meta"):
        name = "index-gc" if store == "primary" else "index-gc-meta"
        meaning = "superseded generations stay until the next run"
        if config["index_gc_files"]:
            steps.append((name, ["dt-cloud", "index-gc", "-s", store, "-m", "2d", *files], env, meaning))
        else:
            steps += [
                (name, ["dt-cloud", "index-gc", "-s", store], env, meaning),
                (f"{name}-files", ["dt-cloud", "index-gc", "-s", store, "-R", "-n", "-m", "2d", *files], env, "the would-delete list is missing from this run's log"),
            ]
    return steps


class MetaReporter:
    """The primary reporter owns the meta phase; secondary indexes use their own store namespace."""

    @contextmanager
    def phase(self, name: str):
        print(f"META-PHASE {name}", file=stderr, flush=True)
        yield

    def step(self, name: str, command: list[str], env: dict[str, str], meaning: str) -> int:
        print(f"META-PHASE {name}", file=stderr, flush=True)
        rc = run(command, env=env).returncode
        if rc:
            print(f"WARN: meta {name} failed (exit {rc})", file=stderr, flush=True)
            alert("warn", f"meta {name} failed (exit {rc}): {meaning}")
        return rc


def execute_meta(
    config: dict,
    scan: str,
    generation: str,
    work: Path,
) -> None:
    execute_scan({**config, "buckets": [config["data_bucket"], config["serving_bucket"]]}, scan, generation, work, MetaReporter(), meta=True)


def execute_scan(
    config: dict,
    scan: str,
    generation: str,
    work: Path,
    reporter: ScanReporter | MetaReporter,
    meta: bool = False,
) -> None:
    for name in config["secrets"]:
        if not environ.get(name):
            raise ClickException(f"Missing runtime secret: {name}")
    work.mkdir(parents=True, exist_ok=False)
    source = {
        **environ,
        "AWS_ACCESS_KEY_ID": environ["R2_ACCESS_KEY_ID" if meta else "SOURCE_ACCESS_KEY_ID"].strip(),
        "AWS_SECRET_ACCESS_KEY": environ["R2_SECRET_ACCESS_KEY" if meta else "SOURCE_SECRET_ACCESS_KEY"].strip(),
    }
    endpoint = environ["DISK_TREE_R2_ENDPOINT_URL"]
    with reporter.phase("listing"):
        for bucket in config["buckets"]:
            print(f"Listing metadata: {bucket}", file=stderr, flush=True)
            scheme = "gcs" if meta and bucket == config["data_bucket"] else "r2"
            command = ["disk-tree", "bulk-list", f"{scheme}://{bucket}", "-o", str(work / "listing" / bucket), "-P", "4", "-w", "4"]
            if scheme == "r2":
                command.extend(("-E", endpoint))
            run(command, env=source, check=True)
    with reporter.phase("path-index"):
        run([
            "dt-cloud", "path-index", "-U", "-d", scan,
            "-l", str(work / "listing/*/shard-*.parquet"),
            "-P", str(work / "index/path-index.parquet"), "-o", str(work / "snap"),
        ], check=True)
    with reporter.phase("age-index"):
        build_age(work / "index/path-index.parquet", work / "index")
    with reporter.phase("verify"):
        report = verify_scan(work, config, scan)
    report["generation"] = generation
    (work / "verification.json").write_text(dumps(report, indent=2) + "\n")
    from dt_cloud.index_footer import extract, write_groups_blob, write_groups_parquet

    from dt_cloud.index import AGE_PYRAMID_VARIANTS

    for variant in ("path-index", "path-index-bysize", *AGE_PYRAMID_VARIANTS.values()):
        path = str(work / "index" / f"{variant}.parquet")
        schema, rows = extract(path)
        write_groups_blob(path, schema, rows)
        write_groups_parquet(path, schema, rows)
    from google.cloud.storage import Client

    data = Client(project=config["project"]).bucket(config["data_bucket"])
    with reporter.phase("archive"):
        for path in sorted(work.rglob("*")):
            if path.is_file() and not any(part.startswith(".") for part in path.relative_to(work).parts):
                data.blob(f"{'meta-scans' if meta else 'scans'}/{scan}/{generation}/{path.relative_to(work)}").upload_from_filename(str(path), if_generation_match=0)
    from boto3 import client

    publisher = client(
        "s3",
        endpoint_url=endpoint,
        region_name="auto",
        aws_access_key_id=environ["R2_ACCESS_KEY_ID"].strip(),
        aws_secret_access_key=environ["R2_SECRET_ACCESS_KEY"].strip(),
    )
    key = f"{'meta-l2' if meta else 'listing'}/{scan}/index/{generation}"
    uploaded = []
    with reporter.phase("upload"):
        for directory, prefix in ((work / "index", key), (work / "snap", f"snapshots/{'meta' if meta else 'r2'}/{scan}")):
            for path in sorted(directory.iterdir()):
                if path.is_file():
                    object_key = f"{prefix}/{path.name}"
                    publisher.upload_file(str(path), config["serving_bucket"], object_key)
                    uploaded.append((object_key, path.stat().st_size))
        manifest = dumps(report).encode()
        publisher.put_object(Bucket=config["serving_bucket"], Key=f"{key}/verification.json", Body=manifest)
        uploaded.append((f"{key}/verification.json", len(manifest)))
        verify_uploads(publisher, config["serving_bucket"], uploaded)
    # Stage every variant's rows before any complete scan becomes visible.
    sync = [
        "dt-cloud", "index-sync", scan,
        "-s", "meta" if meta else "primary",
        "-b", f"r2://{config['serving_bucket']}", "-d", str(work / "index"),
        "-g", generation, "-k", key,
    ]
    for variant in ("path", "bysize", *AGE_PYRAMID_VARIANTS.values()):
        sync.extend(("-v", variant))
    with reporter.phase("publish"):
        run([*sync, "-r"], env=index_env(), check=True)
        run([*sync, "-p"], env=index_env(), check=True)
        data.blob(f"{'meta-scans' if meta else 'scans'}/{scan}/{generation}/_SUCCESS.json").upload_from_string(dumps(report), content_type="application/json", if_generation_match=0)
    index_store(config, work, reporter, meta)
    print(dumps(report))


def index_store(
    config: dict,
    work: Path,
    reporter: ScanReporter | MetaReporter,
    meta: bool,
) -> None:
    """The store's static name index and (primary only: the site reads a secondary store per-scan) its interval
    store, over the published scans' `path` sorts on R2: the first run builds each base generation over every scan
    so far, later runs append each scan after its newest. Never fatal: a failed stage warns, and the next run's
    `add` catches up (the site reads a scan an index doesn't hold per-scan, or says it isn't searchable yet)."""
    from dt_cloud.blobstore import Store

    store = f"r2://{config['serving_bucket']}"
    common = ["-L", f"{'meta-l2' if meta else 'listing'}/{{id}}/index/{{gen}}/path-index.parquet", "-s", store, "-o", store,
              "-M", environ.get("DUCKDB_MEM", "12GB"), "-p", environ.get("DUCKDB_THREADS", "8")]
    env = index_env()
    # The existence checks below read the index bucket from this process: without its key they read nothing, and every
    # stage would `build` (refused over an existing generation).
    environ.update(AWS_ACCESS_KEY_ID=env["AWS_ACCESS_KEY_ID"], AWS_SECRET_ACCESS_KEY=env["AWS_SECRET_ACCESS_KEY"])
    stages = [("static-names", config["meta_static_gen" if meta else "static_gen"], ["-x", "16,8"])]
    if not meta:
        stages.append(("interval-store", config["interval_gen"], []))
    for kind, gen, build_args in stages:
        # The interval store compacts into successor generations (`G.c001`, …) and prunes the old one, so `gen` only
        # names its first build: `add` without `-g` follows `CURRENT.json` (or adopts the sole generation and writes it).
        current = kind == "interval-store" and Store(store).exists("interval-store/CURRENT.json")
        verb = "add" if current or Store(store).exists(f"{kind}/{gen}/scans.json") else "build"
        pin = verb == "build" or kind != "interval-store"
        command = ["dt-cloud", kind, verb, *(["-g", gen] if pin else []), *common, "-w", str(work / kind), *(build_args if verb == "build" else [])]
        print(join(command), file=stderr, flush=True)
        reporter.step(kind, command, env, f"{kind} {verb} didn't take this scan; a later run catches up")


