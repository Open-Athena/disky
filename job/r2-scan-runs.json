{
  "name": "oa-r2",
  "comment": "OA R2 full metadata scans only; age-only maintenance jobs are excluded. Outputs are measured from this deployment's immutable GCS archive. No unverified price estimate.",
  "store": "primary",
  "project": "oa-internal-450019",
  "regions": ["us-west1"],
  "jobs": [
    {
      "kind": "scan",
      "where": {
        "image": "^us-west1-docker\\.pkg\\.dev/oa-internal-450019/oa-r2-usage/scan@sha256:",
        "entrypoint": "^$",
        "no_env": ["OA_R2_META_ONLY"]
      },
      "scan": [
        {"log": "^OA-R2-SCAN-START (\\S+)"},
        {"log": "^index-sync: (\\S+)"},
        {"started": "%Y-%m-%dT%H%M"}
      ]
    }
  ],
  "outputs": [
    {"key": "listing", "uri": "gs://oa-r2-usage-data/scans/{scan}/{gen}/listing/", "split": "dir", "rows": {"json": "_SUCCESS.json", "field": "objects"}, "after": "archive"},
    {"key": "path-index", "uri": "gs://oa-r2-usage-data/scans/{scan}/{gen}/index/", "split": "stem", "rows": "groups", "after": "archive"},
    {"key": "snapshot", "uri": "gs://oa-r2-usage-data/scans/{scan}/{gen}/snap/", "after": "archive"}
  ],
  "log_days": 30
}
