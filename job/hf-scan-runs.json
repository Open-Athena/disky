{
  "name": "hf",
  "comment": "The hf deployment's scan-run profile (specs/scan-runs-ui.md, specs/scan-job-wrapper.md): `dt-cloud scan-run -c job/hf-scan-runs.json`. Prices: list $/h, us-central1, compute only.",
  "project": "oa-internal-450019",
  "regions": ["us-central1"],
  "jobs": [
    {"kind": "scan", "where": {"commands": "job/hf-run\\.sh"},
     "scan": [{"env": "SNAP_ID"}, {"log": "^HF-SCAN-JOB-DONE (\\S+)"}, {"started": "%Y-%m-%d"}]}
  ],
  "error_marker": ["^\\+\\+ scan_err (?P<rc>\\d+) (?P<line>\\d+) (?P<cmd>.*)"],
  "alerts": {"label": "Hugging Face scan", "logs_url": "https://console.cloud.google.com/logs/query;query=labels.job_uid%3D%22{job_uid}%22?project={project}"},
  "secrets": ["HF_TOKEN", "CLOUDFLARE_API_TOKEN", "CF_PAGES_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "R2_ENDPOINT", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "SLACK_BOT_TOKEN", "SITE_TOKEN"],
  "outputs": [
    {"key": "layer-2", "uri": "r2://oa-hf-usage-index/listing/{scan}/", "exclude": ["index/"], "split": "stem", "after": "upload"},
    {"key": "path-index", "uri": "r2://oa-hf-usage-index/listing/{scan}/index/{gen}/", "split": "stem", "rows": "groups", "after": "upload"},
    {"key": "snapshot", "uri": "r2://oa-hf-usage-index/snapshots/hf/{scan}/", "after": "upload"},
    {"key": "static", "uri": "r2://oa-hf-usage-index/static-names/*/manifests/{scan}.json", "manifest": true},
    {"key": "intervals", "uri": "r2://oa-hf-usage-index/interval-store/*/manifests/{scan}.json", "manifest": true}
  ],
  "prices": {"e2-standard-4": 0.134, "n2-standard-4": 0.1942},
  "log_days": 30
}
