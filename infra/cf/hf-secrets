#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["click"]
# ///
"""Deliver the `hf` stacks' credentials where they're read, without ever printing a value.

  -P  the site's Pages (production) secrets:
        STORE_ENDPOINT           https://$CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
        STORE_ACCESS_KEY_ID      the `site_r2_access_key_id` CF output (R2 read on the index bucket)
        STORE_SECRET_ACCESS_KEY  the `site_r2_secret_access_key` CF output
        SESSION_SECRET           fresh 48 random bytes, kept in `<worktree>/tmp/.session-secret` (mode 600) so a
                                 re-run reuses it; delete the file once the project carries it
        RESEND_API_KEY           from the environment (the OA `.envrc`); MAIL_FROM "Open Athena <noreply@oa.dev>"
  -d  the same Pages secrets on the `preview` environment: the dev stack (`site/deploy --dev` → dev.hf.oa.dev) shares
      prod's D1, so it shares the session key too
  -g  the job's Secret Manager versions (the containers are the `hf` GCP stack's):
        hf-usage-cf-token              the `job_d1_token` CF output (D1 edit)
        hf-usage-cf-pages-token        the `job_pages_token` CF output (Pages edit: the digest's plot upload)
        hf-usage-cf-account-id         $CLOUDFLARE_ACCOUNT_ID
        hf-usage-r2-endpoint           https://$CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
        hf-usage-r2-access-key-id      the `r2_s3_access_key_id` CF output (R2 read/write on the index bucket)
        hf-usage-r2-secret-access-key  the `r2_s3_secret_access_key` CF output

Not here: `hf-usage-hf-token` (a Hub read token on the org), `hf-usage-slack-bot-token` (the HF Usage Bot app,
`job/slack/`) and `hf-usage-job-grant` (the site grant, minted from /admin) are added by hand, and the Google OAuth client by the auth repo's `scripts/provision-oauth-client.mjs` (as cw-s3's).
`-n` prints the plan by name only. Needs `$CF_IAC_TOKEN` (stack outputs) and `$CLOUDFLARE_ACCOUNT_ID`.
"""
from __future__ import annotations

import base64
import json
import os
import re
import secrets
import subprocess
import sys
from functools import partial
from pathlib import Path

import click

err = partial(print, file=sys.stderr)

CF_DIR = Path(__file__).resolve().parent
ROOT = CF_DIR.parents[1]  # the worktree (this is infra/cf/)
SITE = ROOT / "site"
SECRET_FILE = ROOT / "tmp" / ".session-secret"
MAIL_FROM = "Open Athena <noreply@oa.dev>"
STACK = "hf"
GCP_PROJECT = "oa-internal-450019"


def need(name: str) -> str:
    v = os.environ.get(name, "").strip()
    if not v:
        raise click.ClickException(f"${name} is not set (direnv loads it)")
    return v


def stack_outputs() -> dict[str, str]:
    env = {**os.environ, "CLOUDFLARE_API_TOKEN": need("CF_IAC_TOKEN")}
    out = subprocess.run(["pulumi", "stack", "output", "--show-secrets", "--json", "-s", STACK],
                         cwd=CF_DIR, env=env, check=True, capture_output=True, text=True).stdout
    return json.loads(out)


def pages_project() -> str:
    m = re.search(r'^name = "([^"]+)"', (SITE / "wrangler.toml").read_text(), re.M)
    if not m:
        raise click.ClickException(f"no `name = …` in {SITE / 'wrangler.toml'}")
    return m.group(1)


def session_secret(dry_run: bool) -> str:
    if SECRET_FILE.exists():
        return SECRET_FILE.read_text().strip()
    value = base64.b64encode(secrets.token_bytes(48)).decode()
    if not dry_run:
        SECRET_FILE.parent.mkdir(parents=True, exist_ok=True)
        SECRET_FILE.touch(mode=0o600)
        SECRET_FILE.write_text(value)
    return value


def run(cmd: list[str], value: str, what: str, dry_run: bool, env: dict[str, str] | None = None, cwd: Path | None = None) -> None:
    err(what)
    if dry_run:
        return
    r = subprocess.run(cmd, input=value, env=env, cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:  # never echo stdin; the tools' stderr doesn't carry the value
        raise click.ClickException(f"{' '.join(cmd)} failed ({r.returncode}):\n{r.stderr.strip()[-600:]}")


@click.command()
@click.option("-d", "--dev", is_flag=True, help="the site's Pages preview (dev stack) secrets: the same values")
@click.option("-g", "--gcp", is_flag=True, help="the job's Secret Manager versions")
@click.option("-n", "--dry-run", is_flag=True, help="print the plan (names only), write nothing")
@click.option("-P", "--pages", is_flag=True, help="the site's Pages production secrets")
def main(dev: bool, gcp: bool, dry_run: bool, pages: bool) -> None:
    if not (dev or gcp or pages):
        raise click.UsageError("pick -P (Pages production), -d (Pages preview) and/or -g (Secret Manager)")
    account = need("CLOUDFLARE_ACCOUNT_ID")
    endpoint = f"https://{account}.r2.cloudflarestorage.com"
    out = {} if dry_run else stack_outputs()
    o = lambda k: out.get(k, "")  # noqa: E731 — empty on a dry run
    envs = [*([[]] if pages else []), *([["--env", "preview"]] if dev else [])]
    if envs:
        project = pages_project()
        values = {
            "STORE_ENDPOINT": endpoint,
            "STORE_ACCESS_KEY_ID": o("site_r2_access_key_id"),
            "STORE_SECRET_ACCESS_KEY": o("site_r2_secret_access_key"),
            "SESSION_SECRET": session_secret(dry_run),
            "RESEND_API_KEY": "" if dry_run else need("RESEND_API_KEY"),
            "MAIL_FROM": MAIL_FROM,
        }
        env = {**os.environ, "CLOUDFLARE_ACCOUNT_ID": account}
        for flags in envs:
            where = f"pages {project}{' preview' if flags else ''}"
            for k, v in values.items():
                run(["pnpm", "exec", "wrangler", "pages", "secret", "put", k, "--project-name", project, *flags], v, f"[{where}] {k}", dry_run, env=env, cwd=SITE)
        err(f"session secret kept in {SECRET_FILE} (mode 600) until the project carries it — then delete it")
    if gcp:
        values = {
            "hf-usage-cf-token": o("job_d1_token"),
            "hf-usage-cf-pages-token": o("job_pages_token"),
            "hf-usage-cf-account-id": account,
            "hf-usage-r2-endpoint": endpoint,
            "hf-usage-r2-access-key-id": o("r2_s3_access_key_id"),
            "hf-usage-r2-secret-access-key": o("r2_s3_secret_access_key"),
        }
        for sid, v in values.items():
            run(["gcloud", "secrets", "versions", "add", sid, f"--project={GCP_PROJECT}", "--data-file=-"], v, f"[secret manager] {sid}", dry_run)


if __name__ == "__main__":
    main()
