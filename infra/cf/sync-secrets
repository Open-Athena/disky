#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["click", "pyyaml"]
# ///
"""Sync this deployment's reader and session secrets to Pages, without printing values."""

from json import dumps, loads
from os import O_CREAT, O_EXCL, O_TRUNC, O_WRONLY, environ, fchmod, fdopen, open as os_open
from pathlib import Path
from secrets import token_hex
from subprocess import run
from sys import stderr

from click import ClickException, command, option
from yaml import safe_load


HERE = Path(__file__).resolve().parent


def private_session(path: Path) -> str:
    if path.exists():
        value = path.read_text().strip()
        if len(value) != 64 or any(c not in "0123456789abcdef" for c in value):
            raise ValueError("Invalid saved session secret")
        return value
    value = token_hex(32)
    with fdopen(os_open(path, O_WRONLY | O_CREAT | O_EXCL, 0o600), "w") as file:
        file.write(value + "\n")
    return value


def pages_secrets(
    outputs: dict[str, str],
    account: str,
    session: str,
) -> dict[str, str]:
    return {
        "SESSION_SECRET": session,
        "STORE_ENDPOINT": f"https://{account}.r2.cloudflarestorage.com",
        "STORE_ACCESS_KEY_ID": outputs["index_s3_access_key_id"],
        "STORE_SECRET_ACCESS_KEY": outputs["index_s3_secret_access_key"],
    }


def job_secrets(outputs: dict[str, str]) -> dict[str, str]:
    return {
        "SOURCE_ACCESS_KEY_ID": outputs["source_s3_access_key_id"],
        "SOURCE_SECRET_ACCESS_KEY": outputs["source_s3_secret_access_key"],
        "R2_ACCESS_KEY_ID": outputs["r2_s3_access_key_id"],
        "R2_SECRET_ACCESS_KEY": outputs["r2_s3_secret_access_key"],
        "CLOUDFLARE_API_TOKEN": outputs["d1_publish_token"],
        # optional (`job/r2.json` `optional_secrets`): the digest's plot upload, once the stack has the icons project
        **({"CF_PAGES_TOKEN": outputs["job_pages_token"]} if "job_pages_token" in outputs else {}),
    }


def oauth_secrets(client: dict) -> dict[str, str]:
    web = client["web"]
    origins = {
        "https://r2.oa.dev", "https://dev.r2.oa.dev", "https://r2.oa-r2-usage.pages.dev",
        "http://localhost:3273", "http://127.0.0.1:3273",
    }
    if web["project_id"] != "oa-auth-509611":
        raise ValueError("OAuth client must use the OA auth project")
    if set(web["javascript_origins"]) != origins or set(web["redirect_uris"]) != {origin + "/auth/google/callback" for origin in origins}:
        raise ValueError("OAuth origins and callbacks must match only this deployment")
    if not web["client_id"].endswith(".apps.googleusercontent.com") or not web["client_secret"]:
        raise ValueError("OAuth client ID and secret are required")
    return {"GOOGLE_CLIENT_ID": web["client_id"], "GOOGLE_CLIENT_SECRET": web["client_secret"]}


def apply_secrets(
    values: dict[str, str],
    project: str,
    target: str,
    environment: dict[str, str],
    wrangler: str,
) -> None:
    for name, value in values.items():
        result = run(
            [wrangler, "pages", "secret", "put", name, "--project-name", project, "--env", target],
            input=value,
            env=environment,
            cwd=HERE.parents[1] / "site",
            capture_output=True,
            text=True,
        )
        if result.returncode:
            # CLI diagnostics may repeat provider request data; retain names and exit status only.
            raise ClickException(f"Pages {project}/{target}: {name} failed (exit {result.returncode})")
        print(f"Pages {project}/{target}: {name} installed", file=stderr)


@command()
@option("-g", "--gsm", is_flag=True, help="Install source, publisher, D1 and (with the icons project) Pages token payloads in this deployment's GCP secret containers")
@option("-l", "--local", is_flag=True, help="Write private reader/session/OAuth dev vars for the local full stack")
@option("-n", "--dry-run", is_flag=True, help="Print target and secret names only; do not read or write secret values")
@option("-o", "--oauth-json", type=Path, help="Downloaded new OAuth client JSON; validated against this deployment's origins")
@option("-p", "--preview", is_flag=True, help="Sync the preview environment")
@option("-P", "--production", is_flag=True, help="Sync the production environment")
@option("-s", "--stack", default="r2", show_default=True, help="This deployment's Cloudflare stack")
@option("-w", "--wrangler", default="wrangler", show_default=True, help="Installed Wrangler executable")
def main(
    gsm: bool,
    local: bool,
    dry_run: bool,
    oauth_json: Path | None,
    preview: bool,
    production: bool,
    stack: str,
    wrangler: str,
) -> None:
    targets = (["preview"] if preview else []) + (["production"] if production else [])
    if not targets and not gsm and not local:
        raise ClickException("Choose -g/--gsm, -l/--local, -p/--preview or -P/--production")
    config = safe_load((HERE / f"Pulumi.{stack}.yaml").read_text())["config"]
    project_config = safe_load((HERE / "Pulumi.yaml").read_text())
    prefix = project_config["name"] + ":"
    project = config[prefix + "pagesProject"]
    account = config[prefix + "accountId"]
    for target in targets:
        names = "SESSION_SECRET, STORE_ENDPOINT, STORE_ACCESS_KEY_ID, STORE_SECRET_ACCESS_KEY"
        if oauth_json:
            names += ", GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET"
        print(f"Pages {project}/{target}: {names}", file=stderr)
    if local:
        print("Local site/.dev.vars: private session, reader and selected sign-in transport", file=stderr)
    job_profile = loads((HERE.parents[1] / "job/r2.json").read_text()) if gsm else None
    if job_profile:
        if job_profile["account"] != account or job_profile["serving_bucket"] != config[prefix + "r2Bucket"]:
            raise ClickException("Job profile does not match this deployment")
        print(f"GCP {job_profile['project']}: {', '.join(job_profile['secrets'].values())}", file=stderr)
    if dry_run:
        return
    credential = environ.get("CF_IAC_TOKEN")
    if not credential:
        raise ClickException("Missing CF_IAC_TOKEN")
    passphrase = (HERE / ".envrc").read_text().strip()
    key, separator, value = passphrase.partition("=")
    if key != "export PULUMI_CONFIG_PASSPHRASE" or not separator or len(value) != 64 or any(c not in "0123456789abcdef" for c in value):
        raise ClickException("Expected the generated private stack passphrase file")
    environment = {
        **environ,
        "CLOUDFLARE_API_TOKEN": credential,
        "CLOUDFLARE_ACCOUNT_ID": account,
        "PULUMI_CONFIG_PASSPHRASE": value,
    }
    result = run(
        ["pulumi", "-C", str(HERE), "stack", "output", "--show-secrets", "--json", "--stack", stack],
        env=environment,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise ClickException(f"Reading stack outputs failed (exit {result.returncode})")
    outputs = loads(result.stdout)
    if outputs["pages_project"] != project or outputs["r2_bucket"] != config[prefix + "r2Bucket"]:
        raise ClickException("Stack outputs do not match this deployment")
    payloads = job_secrets(outputs) if gsm else {}
    if targets or local:
        values = pages_secrets(outputs, account, private_session(HERE / "state" / "session-secret"))
        if oauth_json:
            values.update(oauth_secrets(loads(oauth_json.read_text())))
        for target in targets:
            apply_secrets(values, project, target, environment, wrangler)
        if local:
            path = HERE.parents[1] / "site/.dev.vars"
            descriptor = os_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0o600)
            with fdopen(descriptor, "w") as file:
                fchmod(descriptor, 0o600)
                file.write("".join(f"{name}={dumps(value)}\n" for name, value in {**values, "DEV_EMAIL": "ryan.williams@openathena.ai"}.items()))
    if job_profile:
        # The Slack bot token and the site grant are optional secrets added by hand (`specs/r2-deployment.md`)
        for name, secret in [*job_profile["secrets"].items(), *((n, s) for n, s in job_profile["optional_secrets"].items() if n in payloads)]:
            result = run(
                ["gcloud", "secrets", "versions", "add", secret, "--project", job_profile["project"], "--data-file=-"],
                input=payloads[name], env=environment, capture_output=True, text=True,
            )
            if result.returncode:
                raise ClickException(f"GCP {secret} failed (exit {result.returncode})")
            print(f"GCP {secret}: payload installed", file=stderr)


if __name__ == "__main__":
    main()
